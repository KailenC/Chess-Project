# =========================
# CHESS PROJECT CLEAN IGNORE
# =========================

# ---- C++ build output ----
build/
engine/build/
bin/
*.exe
*.o
*.obj
*.out
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb

# ---- CMake ----
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ---- CLion / JetBrains ----
.idea/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- VS Code (keep useful config, ignore noise) ----
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---- OS junk ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Logs / temp ----
*.log
*.tmp
